<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="axsync_duplicate_scan_cron" model="ir.cron">
        <field name="name">AXSync: scan for duplicate invoices</field>
        <field name="model_id" ref="model_axsync_duplicate_case"/>
        <field name="state">code</field>
        <field name="code">model.cron_scan_duplicates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
